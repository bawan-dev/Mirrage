MIRRAGE_APP_ENV=development
MIRRAGE_API_PORT=8000
MIRRAGE_FRONTEND_PORT=5173
MIRRAGE_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Local memory database. This file is private local state and should not be
# committed.
MIRRAGE_MEMORY_DATABASE_PATH=data/mirrage-memory.sqlite3

# AI provider: stub | ollama | openai
MIRRAGE_AI_PROVIDER=stub
# MIRRAGE_AI_MODEL=
# MIRRAGE_AI_BASE_URL=
# MIRRAGE_AI_API_KEY=

# Local, private model via Ollama (https://ollama.com):
#   MIRRAGE_AI_PROVIDER=ollama
#   MIRRAGE_AI_MODEL=llama3.2

# Hosted, OpenAI-compatible model:
#   MIRRAGE_AI_PROVIDER=openai
#   MIRRAGE_AI_MODEL=gpt-4o-mini
#   MIRRAGE_AI_API_KEY=sk-...

# Spotify integration:
# 1. Create a Spotify app in the Spotify Developer Dashboard.
# 2. Add this redirect URI to that app:
#    http://127.0.0.1:8000/api/integrations/spotify/callback
# 3. Put the client ID and client secret here.
# MIRRAGE_FRONTEND_URL=http://127.0.0.1:5173
# MIRRAGE_SPOTIFY_CLIENT_ID=
# MIRRAGE_SPOTIFY_CLIENT_SECRET=
# MIRRAGE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/integrations/spotify/callback

# Google Calendar integration:
# 1. Enable the Google Calendar API in Google Cloud.
# 2. Create an OAuth client with this redirect URI:
#    http://127.0.0.1:8000/api/integrations/calendar/callback
# 3. Put the OAuth client ID and client secret here.
# MIRRAGE_GOOGLE_CALENDAR_CLIENT_ID=
# MIRRAGE_GOOGLE_CALENDAR_CLIENT_SECRET=
# MIRRAGE_GOOGLE_CALENDAR_REDIRECT_URI=http://127.0.0.1:8000/api/integrations/calendar/callback
# MIRRAGE_GOOGLE_CALENDAR_ID=primary
# MIRRAGE_GOOGLE_CALENDAR_TIME_ZONE=Europe/London

# Wake word and presence engine. Wake audio should stay inside the configured
# local wake engine. Mirrage receives detection events after the phrase is heard.
MIRRAGE_WAKE_WORD_ENABLED=true
MIRRAGE_WAKE_PHRASE="Hey Mirrage"
MIRRAGE_WAKE_WORD_ENGINE=adapter
MIRRAGE_WAKE_WORD_SENSITIVITY=0.55
# MIRRAGE_VOICE_MICROPHONE_DEVICE=
MIRRAGE_PRESENCE_INACTIVITY_TIMEOUT_SECONDS=25
MIRRAGE_PRESENCE_AUTOMATIC_SLEEP=true

# Frontend mirror display mode. Leave false for normal development.
VITE_MIRROR_MODE=false
VITE_MIRROR_DIM_TIMEOUT_SECONDS=60
VITE_MIRROR_SLEEP_TIMEOUT_SECONDS=120
VITE_MIRROR_STARTUP_SECONDS=3
VITE_MIRROR_BURN_IN_SHIFT_SECONDS=45
VITE_EXPERIMENTAL_BROWSER_WAKE_WORD=false
