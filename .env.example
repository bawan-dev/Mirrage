# Backend
MIRRAGE_APP_VERSION=2.0.0-dev
MIRRAGE_APP_ENV=development
MIRRAGE_API_PORT=8000
MIRRAGE_FRONTEND_URL=http://127.0.0.1:5173
MIRRAGE_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Frontend
MIRRAGE_FRONTEND_PORT=5173
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_MIRRAGE_DEMO_MODE=false
VITE_MIRROR_MODE=false
VITE_MIRROR_DIM_TIMEOUT_SECONDS=60
VITE_MIRROR_SLEEP_TIMEOUT_SECONDS=120
VITE_MIRROR_STARTUP_SECONDS=3
VITE_MIRROR_BURN_IN_SHIFT_SECONDS=45
VITE_EXPERIMENTAL_BROWSER_WAKE_WORD=false

# Logging
MIRRAGE_LOG_LEVEL=INFO
MIRRAGE_LOG_JSON=true
# MIRRAGE_LOG_FILE=logs/backend.log

# Local memory and backups. These files are private local state and should not
# be committed.
MIRRAGE_MEMORY_DATABASE_PATH=data/mirrage-memory.sqlite3
MIRRAGE_BACKUP_DIRECTORY=backups

# Identity, trusted devices, approvals, and append-only audit history.
# Keep the development bypass false unless you deliberately need a local-only
# principal. Production rejects the bypass and requires enforced mode.
MIRRAGE_IDENTITY_ENABLED=true
MIRRAGE_IDENTITY_MODE=development
MIRRAGE_IDENTITY_DATABASE_PATH=data/mirrage-identity.sqlite3
MIRRAGE_IDENTITY_DEVICE_TOKEN_BYTES=32
MIRRAGE_IDENTITY_SESSION_TTL_SECONDS=86400
MIRRAGE_APPROVAL_TTL_SECONDS=120
MIRRAGE_AUDIT_RETENTION_DAYS=365
MIRRAGE_IDENTITY_DEV_BYPASS=false

# AI Runtime
# Providers: stub | ollama | openai
MIRRAGE_AI_PROVIDER=stub
# MIRRAGE_AI_MODEL=
# MIRRAGE_AI_BASE_URL=
# MIRRAGE_AI_API_KEY=
MIRRAGE_AI_RUNTIME_MODE=standard
MIRRAGE_AI_LOCAL_FIRST=false
MIRRAGE_AI_LOCAL_ONLY=false
MIRRAGE_AI_FALLBACK_PROVIDER=stub
MIRRAGE_AI_STREAMING_ENABLED=true
MIRRAGE_AI_PRIVACY_MODE=limited_cloud_context
# MIRRAGE_AI_DEFAULT_TASK_MODEL=
# MIRRAGE_AI_SUMMARY_MODEL=
# MIRRAGE_AI_PLANNING_MODEL=

# Local, private model via Ollama:
#   MIRRAGE_AI_PROVIDER=ollama
#   MIRRAGE_AI_MODEL=llama3.2
#   MIRRAGE_AI_LOCAL_FIRST=true

# Hosted, OpenAI-compatible model:
#   MIRRAGE_AI_PROVIDER=openai
#   MIRRAGE_AI_MODEL=gpt-4o-mini
#   MIRRAGE_AI_API_KEY=sk-...

# Weather
MIRRAGE_WEATHER_LATITUDE=-36.8485
MIRRAGE_WEATHER_LONGITUDE=174.7633
MIRRAGE_WEATHER_LOCATION=Auckland

# Smart Home / Home Assistant
MIRRAGE_SMART_HOME_ENABLED=false
MIRRAGE_SMART_HOME_TIMEOUT_SECONDS=5
MIRRAGE_HOME_ASSISTANT_ENABLED=false
MIRRAGE_HOME_ASSISTANT_BASE_URL=http://homeassistant.local:8123
# MIRRAGE_HOME_ASSISTANT_TOKEN=

# Voice, wake word, and presence engine. Wake audio should stay inside the
# configured local wake engine. Mirrage receives detection events after the
# phrase is heard.
MIRRAGE_WAKE_WORD_ENABLED=true
MIRRAGE_WAKE_PHRASE="Hey Mirrage"
MIRRAGE_WAKE_WORD_ENGINE=adapter
MIRRAGE_WAKE_WORD_SENSITIVITY=0.55
# MIRRAGE_VOICE_MICROPHONE_DEVICE=
MIRRAGE_PRESENCE_INACTIVITY_TIMEOUT_SECONDS=25
MIRRAGE_PRESENCE_AUTOMATIC_SLEEP=true

# Local wake engine runtime. Disabled by default so local development and CI do
# not require OpenWakeWord, a microphone, or a model file.
MIRRAGE_WAKE_ENGINE_ENABLED=false
MIRRAGE_WAKE_ENGINE_PROVIDER=openwakeword
# MIRRAGE_WAKE_ENGINE_MODEL_PATH=models/wake/hey-mirrage.onnx
MIRRAGE_WAKE_ENGINE_PHRASE="Hey Mirrage"
MIRRAGE_WAKE_ENGINE_SENSITIVITY=0.5
# MIRRAGE_WAKE_ENGINE_MICROPHONE=
MIRRAGE_WAKE_ENGINE_SAMPLE_RATE=16000
MIRRAGE_WAKE_ENGINE_FRAME_MS=80
MIRRAGE_WAKE_ENGINE_COOLDOWN_SECONDS=3

# Spotify integration:
# 1. Create a Spotify app in the Spotify Developer Dashboard.
# 2. Add this redirect URI:
#    http://127.0.0.1:8000/api/integrations/spotify/callback
# 3. Put the client ID and client secret here.
# MIRRAGE_SPOTIFY_CLIENT_ID=
# MIRRAGE_SPOTIFY_CLIENT_SECRET=
MIRRAGE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/integrations/spotify/callback

# Google Calendar integration:
# 1. Enable the Google Calendar API in Google Cloud.
# 2. Create an OAuth client with this redirect URI:
#    http://127.0.0.1:8000/api/integrations/calendar/callback
# 3. Put the OAuth client ID and client secret here.
# MIRRAGE_GOOGLE_CALENDAR_CLIENT_ID=
# MIRRAGE_GOOGLE_CALENDAR_CLIENT_SECRET=
MIRRAGE_GOOGLE_CALENDAR_REDIRECT_URI=http://127.0.0.1:8000/api/integrations/calendar/callback
MIRRAGE_GOOGLE_CALENDAR_ID=primary
MIRRAGE_GOOGLE_CALENDAR_TIME_ZONE=Europe/London

# Docker production image tag
MIRRAGE_VERSION=local
