FROM node:24-alpine AS build

WORKDIR /app

ARG VITE_API_BASE_URL=http://127.0.0.1:8000
ARG VITE_MIRROR_MODE=true
ARG VITE_MIRROR_DIM_TIMEOUT_SECONDS=60
ARG VITE_MIRROR_SLEEP_TIMEOUT_SECONDS=120
ARG VITE_MIRROR_STARTUP_SECONDS=3
ARG VITE_MIRROR_BURN_IN_SHIFT_SECONDS=45

ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_MIRROR_MODE=$VITE_MIRROR_MODE
ENV VITE_MIRROR_DIM_TIMEOUT_SECONDS=$VITE_MIRROR_DIM_TIMEOUT_SECONDS
ENV VITE_MIRROR_SLEEP_TIMEOUT_SECONDS=$VITE_MIRROR_SLEEP_TIMEOUT_SECONDS
ENV VITE_MIRROR_STARTUP_SECONDS=$VITE_MIRROR_STARTUP_SECONDS
ENV VITE_MIRROR_BURN_IN_SHIFT_SECONDS=$VITE_MIRROR_BURN_IN_SHIFT_SECONDS

COPY frontend/package*.json ./
RUN npm ci

COPY frontend ./
RUN npm run build

FROM nginx:1.27-alpine

COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 5173

HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD wget -qO- http://127.0.0.1:5173/ || exit 1
