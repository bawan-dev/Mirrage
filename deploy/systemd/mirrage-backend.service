[Unit]
Description=Mirrage FastAPI backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mirrage
WorkingDirectory=/opt/mirrage
EnvironmentFile=/opt/mirrage/.env
ExecStart=/opt/mirrage/.venv/bin/uvicorn backend.app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
