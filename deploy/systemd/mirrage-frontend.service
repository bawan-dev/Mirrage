[Unit]
Description=Mirrage frontend preview service
After=network-online.target mirrage-backend.service
Wants=network-online.target

[Service]
Type=simple
User=mirrage
WorkingDirectory=/opt/mirrage/frontend
EnvironmentFile=/opt/mirrage/.env
ExecStart=/usr/bin/npm run preview -- --host 0.0.0.0 --port 5173
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
